#!/bin/bash
# Synthetic stand-ins for system tools. Values are fictional; state lives in the
# sandbox, so it behaves like the real thing without touching anything real.
name=$(basename "$0")
T=$HOME/.local/state/omarchy/toggles
kv() { local f="$HOME/.sandbox-$1"; [ -f "$f" ] && cat "$f" || echo "$2"; }
setkv() { printf '%s\n' "$2" >"$HOME/.sandbox-$1"; }
case "$name" in
pactl)
  case "$*" in
    "-f json list sinks") echo '[{"index":49,"state":"SUSPENDED","name":"example_speaker_tuning","description":"Laptop Speakers","mute":false,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"30","device.description":"Laptop Speakers"}},{"index":151,"state":"RUNNING","name":"alsa_output.pci-0000_00_1f.3.HiFi__Speaker__sink","description":"Example Chipset (Series 3) HD Audio Speaker","mute":false,"volume":{"front-left":{"value_percent":"25%"}},"properties":{"object.id":"84","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"Speaker","device.icon_name":"audio-speakers"}},{"index":152,"state":"SUSPENDED","name":"alsa_output.pci-0000_00_1f.3.HiFi__Headphones__sink","description":"Example Chipset (Series 3) HD Audio Headphones","mute":false,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"76","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"Headphones","device.icon_name":"audio-headphones"}},{"index":153,"state":"SUSPENDED","name":"alsa_output.pci-0000_00_1f.3.HiFi__HDMI1__sink","description":"Example Chipset (Series 3) HD Audio HDMI / DisplayPort 1 Output (Stereo)","mute":false,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"75","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"HDMI / DisplayPort 1 Output","device.icon_name":"video-display"}},{"index":154,"state":"SUSPENDED","name":"alsa_output.pci-0000_00_1f.3.HiFi__HDMI2__sink","description":"Example Chipset (Series 3) HD Audio HDMI / DisplayPort 2 Output (Stereo)","mute":true,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"74","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"HDMI / DisplayPort 2 Output","device.icon_name":"video-display"}},{"index":155,"state":"SUSPENDED","name":"alsa_output.pci-0000_00_1f.3.HiFi__HDMI3__sink","description":"Example Chipset (Series 3) HD Audio HDMI / DisplayPort 3 Output (Stereo)","mute":false,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"73","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"HDMI / DisplayPort 3 Output","device.icon_name":"video-display"}}]';;
    "-f json list sources") echo '[{"index":156,"state":"IDLE","name":"alsa_input.pci-0000_00_1f.3.HiFi__Mic__source","description":"Example Chipset (Series 3) HD Audio Microphones","mute":false,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"object.id":"90","device.description":"Example Chipset (Series 3) HD Audio","device.profile.description":"Microphones","device.icon_name":"audio-input-microphone","device.class":"sound"}},{"index":157,"name":"alsa_output.pci-0000_00_1f.3.HiFi__Speaker__sink.monitor","description":"Monitor of Speaker","mute":false,"volume":{},"properties":{"device.class":"monitor"}}]';;
    "-f json list sink-inputs") echo '[{"index":2919,"sink":151,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"application.name":"Web Browser","application.icon_name":"web-browser","application.process.binary":"browser","media.name":"Playback"}},{"index":2929,"sink":151,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"application.name":"Web Browser","application.icon_name":"web-browser","application.process.binary":"browser","media.name":"Playback"}},{"index":9,"sink":152,"volume":{"front-left":{"value_percent":"100%"}},"properties":{"application.name":"Music Player","media.name":"Example Track"}}]';;
    get-default-sink) echo alsa_output.pci-0000_00_1f.3.HiFi__Speaker__sink;;
    get-default-source) echo alsa_input.pci-0000_00_1f.3.HiFi__Mic__source;;
  esac;;
nmcli)
  case "$*" in
    "-t -f WIFI,CONNECTIVITY general") echo "enabled:full";;
    "-t -f WIFI general") echo enabled;;
    "-t -f DEVICE,TYPE,STATE,CONNECTION device") printf 'wlp0s20f3:wifi:connected:Home network\ntailscale0:tun:connected (externally):tailscale0\n';;
    "-t -f NAME,UUID,TYPE,ACTIVE connection show") printf 'Home network:11111111-1111-1111-1111-111111111111:802-11-wireless:yes\nCafe:22222222-2222-2222-2222-222222222222:802-11-wireless:no\n';;
    "-t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list --rescan no") printf '*:Home network:82:WPA2\n :Cafe:54:WPA2\n :Neighbor:31:WPA3\n :Airport Free:22:\n';;
  esac;;
bluetoothctl)
  case "$1" in
    devices) printf 'Device AA:BB:CC:DD:EE:01 Example Earbuds\nDevice AA:BB:CC:DD:EE:02 Travel Mouse\nDevice AA:BB:CC:DD:EE:03 Office Mouse\nDevice AA:BB:CC:DD:EE:04 Office Mouse\nDevice AA:BB:CC:DD:EE:05 Office Mouse\n';;
    info) case "$2" in
      AA:BB:CC:DD:EE:01) printf 'Name: Example Earbuds\nConnected: no\nPaired: yes\nIcon: audio-headphones\n';;
      AA:BB:CC:DD:EE:02) printf 'Name: Travel Mouse\nConnected: yes\nPaired: yes\nIcon: input-mouse\nBattery Percentage: 0x4c (76)\n';;
      *) printf 'Name: Office Mouse\nConnected: no\nPaired: yes\nIcon: input-mouse\n';;
    esac;;
  esac;;
systemctl)
  case "$*" in
    *list-units*--user*|--user*list-units*) echo '[{"unit":"sync-client.service","load":"loaded","active":"active","sub":"running","description":"Sync client"},{"unit":"broken-helper.service","load":"loaded","active":"failed","sub":"failed","description":"Example helper"}]';;
    *list-units*) echo '[{"unit":"NetworkManager.service","load":"loaded","active":"active","sub":"running","description":"Network Manager"},{"unit":"sshd.service","load":"loaded","active":"inactive","sub":"dead","description":"OpenSSH server"}]';;
    *list-unit-files*) echo '[{"unit_file":"sync-client.service","state":"enabled"},{"unit_file":"broken-helper.service","state":"enabled"},{"unit_file":"NetworkManager.service","state":"enabled"},{"unit_file":"sshd.service","state":"disabled"}]';;
    is-active\ sshd) echo inactive; exit 3;;
    is-active\ ufw) echo active;;
  esac;;
timedatectl)
  case "$*" in
    *Timezone*) echo Europe/Amsterdam;;
    *NTP*) echo yes;;
  esac;;
xdg-mime)
  # Mail goes to an app that is not installed here, so its id shows as configured.
  case "$3" in
    text/plain) echo org.example.TextEditor.desktop;;
    application/pdf) echo org.example.Documents.desktop;;
    image/png) echo org.example.Images.desktop;;
    video/mp4|audio/mpeg) echo org.example.Media.desktop;;
    inode/directory) echo org.gnome.Nautilus.desktop;;
    x-scheme-handler/mailto) echo hey.desktop;;
    *) echo;;
  esac;;
omarchy)
  case "$*" in
    version) echo 4.5.0-3;;
    "version pkgs") echo "Monday 02 November 2026 at 09:14";;
    "channel current") echo stable;;
    "kernel get") echo linux;;
    "theme current") kv theme "Obsidian Circuit";;
    "theme list") printf 'Catppuccin\nEverforest\nObsidian Circuit\nTokyo Night\n';;
    "theme set "*) setkv theme "${*:3}";;
    "font current") echo "JetBrainsMono Nerd Font";;
    "font list") printf 'CaskaydiaMono Nerd Font\nJetBrainsMono Nerd Font\n';;
    "font cjk") echo default;;
    "display text size "*) sed -i "s/base-size = .*/base-size = $5/" "$HOME/.config/omarchy/shell.toml";;
    "hyprland corners") echo theme;;
    "hyprland window transparency") if [ -f "$HOME/.local/state/omarchy/toggles/hypr/window-glassy.lua" ]; then echo glassy; else echo transparent; fi;;
    "hyprland workspace layout default") echo dwindle;;
    "hyprland monitor scaling") echo 1.25;;
    "bar position") echo top;;
    "bar background") if [ -f "$HOME/.local/state/omarchy/toggles/hypr/bar-glassy.lua" ]; then echo glassy; else echo opaque; fi;;
    "bar get omarchy.clock format") echo "ddd d MMM HH:mm";;
    "bar get omarchy.clock verticalFormat") printf 'HH\n—\nmm\n';;
    "dock position") echo bottom;;
    "dock autohide") echo off;;
    "shell shell ping") echo ok;;
    "shell notifications isDnd") echo off;;
    "shell -q "*) ;;
    "plugin list --json") echo '[{"id":"omarchy.audio","name":"Audio","kinds":["bar-widget"],"enabled":true,"active":true,"canDisable":true,"firstParty":true,"clonedFrom":""},{"id":"omarchy.clock","name":"Clock","kinds":["bar-widget"],"enabled":true,"active":true,"canDisable":false,"firstParty":true,"clonedFrom":""},{"id":"omarchy.weather","name":"Weather","kinds":["bar-widget"],"enabled":true,"active":true,"canDisable":true,"firstParty":true,"clonedFrom":""},{"id":"local.notes","name":"Notes","kinds":["bar-widget"],"enabled":false,"active":false,"canDisable":true,"firstParty":false,"clonedFrom":""}]';;
    "audio output sink") echo alsa_output.pci-0000_00_1f.3.HiFi__Speaker__sink;;
    "bluetooth power is-on") exit 0;;
    "brightness display"*)
      # A display listed in .sandbox-nobrightness has neither a backlight nor DDC/CI.
      mon=""; [ "$3" = "--monitor" ] && mon=$4
      if [ -n "$mon" ] && grep -qx "$mon" "$HOME/.sandbox-nobrightness" 2>/dev/null; then exit 1; fi
      echo 72;;
    "powerprofiles list --active-state") printf 'power-saver\t0\nbalanced\t1\nperformance\t0\n';;
    "powerprofiles list") printf 'power-saver\nbalanced\nperformance\n';;
    "powerprofiles set"*) ;;
    "toggle idle status") if [ -f "$HOME/.local/state/omarchy/indicators/stay-awake" ]; then echo '{"enabled":true}'; else echo '{"enabled":false}'; fi;;
    "toggle nightlight --status") echo '{"enabled":false,"temperature":6500}';;
    "hibernation available") exit 1;;
    "dns") echo DHCP;;
    "network band") printf 'band\t5\navailable\t2.4 5\nselected\tauto\n';;
    "default browser") echo firefox;;
    "default terminal") echo foot;;
    "default editor") echo nvim;;
    "plymouth current") echo "Obsidian Circuit";;
  esac;;
esac
exit 0
